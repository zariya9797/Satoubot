# Local Telegram Bot API endpoint, without /bot or token.
BOT_API_URL=http://127.0.0.1:8081
DATA_DIR=./data

# Experimental: 1 is standard; 2-4 sends big-file parts concurrently.
UPLOAD_PARALLEL_PARTS=1
